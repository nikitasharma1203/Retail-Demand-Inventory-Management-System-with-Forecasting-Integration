[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 120

[sqlfluff:rules:L003]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:L010]
# Keywords should be UPPERCASE
capitalisation_policy = upper

[sqlfluff:rules:L014]
# Column aliases should be lower_snake_case
extended_capitalisation_policy = lower
